FROM python:3.11-slim

WORKDIR /app

COPY requirements-api.txt .
RUN pip install --no-cache-dir -r requirements-api.txt

COPY src/ src/
COPY events/ events/

# events/ is baked into the image for Railway/standalone deployment.
# For local dev, docker-compose.yml bind-mounts ./events:/app/events:ro
# which overrides this layer, allowing pipeline output to be refreshed
# without rebuilding the image.
VOLUME ["/app/events", "/app/logs"]

EXPOSE 8000

CMD ["uvicorn", "src.api:app", "--host", "0.0.0.0", "--port", "8000"]
